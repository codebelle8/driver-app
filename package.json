{
  "name": "kurumayose-navi",
  "private": true,
  "description": "車寄せナビ — ドライバー向け施設進入経路・車寄せ位置確認アプリ",
  "scripts": {
    "check:sql": "node tools/check-sql.mjs",
    "check:templates": "node tools/check-templates.mjs",
    "db:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/db-reset.ps1",
    "db:bootstrap": "node tools/build-bootstrap-sql.mjs",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "verify:prod": "node tools/verify-production.mjs",
    "verify:surveyor": "node tools/verify-surveyor.mjs",
    "check:bundle": "node tools/check-bundle.mjs",
    "import:check": "node tools/import-facilities.mjs",
    "import:apply": "node tools/import-facilities.mjs --apply",
    "apk:serve": "node tools/serve-apk.mjs",
    "app:check": "node tools/publish-preview.mjs --check",
    "app:publish": "node tools/publish-preview.mjs",
    "deploy:admin": "node tools/deploy-admin.mjs",
    "deploy:admin:preview": "node tools/deploy-admin.mjs --preview",
    "brand:import": "node tools/import-brand.mjs",
    "test:theme": "node tools/test-theme-toggle.mjs",
    "test:overlay": "node tools/test-loading-overlay.mjs",
    "test:input": "node tools/test-input.mjs",
    "test:surveyor-ui": "node tools/test-surveyor-ui.mjs",
    "test:locale": "node tools/test-locale.mjs",
    "test:app": "node --import ./tools/ts-resolve-hooks.mjs tools/test-app-logic.mjs",
    "test:app-data": "node --import ./tools/ts-resolve-hooks.mjs tools/test-app-data.mjs",
    "shot": "node tools/screenshot.mjs",
    "shot:header": "node tools/screenshot-header.mjs",
    "shot:loading": "node tools/screenshot-loading.mjs",
    "app:start": "npm --prefix app run start:tunnel"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "pg-query-emscripten": "^5.1.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "supabase": "^2.112.0"
  }
}