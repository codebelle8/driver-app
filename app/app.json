{
  "expo": {
    "name": "車寄せナビ",
    "slug": "kurumayose-navi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "kurumayose",
    "userInterfaceStyle": "dark",
    "primaryColor": "#008000",
    "ios": {
      "bundleIdentifier": "net.levelsurface.kurumayose",
      "supportsTablet": false,
      "icon": "./assets/brand/icon.png",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "maps",
          "yjcarnavi"
        ],
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "net.levelsurface.kurumayose",
      "adaptiveIcon": {
        "backgroundColor": "#0B192F",
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "monochromeImage": "./assets/brand/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B192F",
          "image": "./assets/brand/splash-mark.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0B192F",
            "image": "./assets/brand/splash-mark.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "いまいる場所の地名を画面に表示するために使います。また、情報をお送りいただく際に「いまいる場所を添える」を選ばれた場合に限り、その位置を添えて送ります。",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
