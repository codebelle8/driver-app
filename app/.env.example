# Expo では EXPO_PUBLIC_ 接頭辞の変数のみアプリのバンドルに埋め込まれる。
# 秘密鍵の類は絶対にここに置かないこと（バンドルを解析すれば読み取れるため）。

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 施設カタログのスナップショット配信元 (CDN)
EXPO_PUBLIC_CATALOG_BASE_URL=

# --- Google Maps ---
# アプリの地図表示 (Maps SDK for Android / iOS) 用。
#
# **この値は APK を解析すれば読み取れる。** 秘匿できないため、
# Google Cloud 側で「Android アプリ（パッケージ名 + SHA-1）」の
# 制限を必ず掛けること。制限が無いと、他人に使われた分まで
# クライアント様に請求が行く。
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
