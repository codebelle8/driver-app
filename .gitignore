# --- secrets / env ---
.env
.env.*
!.env.example
*.pem
*.p8
*.p12
*.keystore
*.jks
service-account*.json
google-services.json
GoogleService-Info.plist

# --- node / next ---
node_modules/
.next/
out/
dist/
build/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# --- expo / react native ---
.expo/
*.jsbundle
# CNG (Continuous Native Generation): android/ と ios/ は `npx expo prebuild` で
# 常に再生成できるため Git 管理外とする。ネイティブコードを直接編集する必要が
# 生じた場合のみ、この2行を外して追跡対象に切り替える。
app/android/
app/ios/
*.iml

# --- client-supplied assets (large binaries, managed outside git) ---
data/import/**
data/photos/**
!data/import/.gitkeep

# --- os / editor ---
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.idea/
