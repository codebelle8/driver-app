# --- secrets / env ---
.env
.env.*
!.env.example
*.pem
*.p8
*.p12
*.keystore
*.jks
service-account*.json
google-services.json
GoogleService-Info.plist

# --- node / next ---
node_modules/
.next/
out/
dist/
build/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# --- expo / react native ---
.expo/
*.jsbundle
# CNG (Continuous Native Generation): android/ と ios/ は `npx expo prebuild` で
# 常に再生成できるため Git 管理外とする。ネイティブコードを直接編集する必要が
# 生じた場合のみ、この2行を外して追跡対象に切り替える。
app/android/
app/ios/
*.iml

# --- client-supplied assets (large binaries, managed outside git) ---
data/import/**
data/photos/**
!data/import/.gitkeep

# --- os / editor ---
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.idea/

# 派生ファイル (tools/build-bootstrap-sql.mjs が生成)
supabase/_bootstrap.sql
supabase/_pending.sql
tools/screenshots/

# クライアント様ご提供のロゴ原本（受領後にここへ置く）
assets/brand/source/*
!assets/brand/source/README.md

# --- 本番のデータの控え（検査の後片付けの前に取ったもの。Git に入れない） ---
backup/
